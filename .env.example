# Naver Map (Naver Cloud Platform)
# JavaScript Maps API - 프론트엔드에서 사용 (필수)
# 스크립트: https://oapi.map.naver.com/openapi/v3/maps.js?ncpKeyId=YOUR_CLIENT_ID
# 공식 예제: https://github.com/navermaps/maps.js.ncp/blob/master/index.html
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=your_naver_map_client_id

# REST API (Geocoding 등) - 서버 사이드 전용
# Admin에서 주소 → 좌표 변환 시 필요
# NCP 콘솔 > Application Service > Maps에서 발급
NAVER_MAP_CLIENT_SECRET=your_naver_map_client_secret

# Naver Developers 지역 검색 API - 상호명/장소 검색용
# https://developers.naver.com 에서 앱 등록 후 발급 (NCP 키와 별도)
NAVER_SEARCH_CLIENT_ID=your_naver_search_client_id
NAVER_SEARCH_CLIENT_SECRET=your_naver_search_client_secret

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Supabase Access Token (타입 생성용 - 선택적)
# Dashboard > Account > Access Tokens에서 발급
# 발급 후: npx supabase login --token YOUR_TOKEN
# SUPABASE_ACCESS_TOKEN=your_access_token
