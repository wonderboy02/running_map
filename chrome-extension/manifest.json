{
  "manifest_version": 3,
  "name": "네이버 지도 장소 추출기",
  "version": "1.0.0",
  "description": "네이버 지도 검색 결과에서 장소명을 추출하여 저장합니다.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://map.naver.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "네이버 지도 장소 추출기"
  },
  "content_scripts": [
    {
      "matches": ["https://map.naver.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
